{% liquid
  assign carousel_settings = block.settings

  assign has_cta = false
  if carousel_settings.button_label != blank
    assign has_cta = true
  endif
%}

<community-carousel
  class="community-carousel"
  style="
    --community-carousel-background: {{ carousel_settings.background_color }};
    --community-carousel-heading-color: {{ carousel_settings.heading_color }};
    --community-carousel-button-background: {{ carousel_settings.button_background }};
    --community-carousel-button-text-color: {{ carousel_settings.button_text_color }};
    --community-carousel-card-gap: {{ carousel_settings.card_gap }}px;
    --community-carousel-padding-block-start: {{ carousel_settings.padding-block-start }}px;
    --community-carousel-padding-block-end: {{ carousel_settings.padding-block-end }}px;
    --community-carousel-padding-inline: {{ carousel_settings.padding-inline }}px;
    --community-carousel-dot-color: {{ carousel_settings.dot_color }};
  "
  {{ block.shopify_attributes }}
>
  {%- if carousel_settings.heading != blank -%}
    <h2 class="community-carousel__heading">{{ carousel_settings.heading }}</h2>
  {%- endif -%}

  {%- if has_cta -%}
    <a
      class="community-carousel__cta"
      href="{{ carousel_settings.button_link | default: '#' }}"
    >
      {{- carousel_settings.button_label -}}
    </a>
  {%- endif -%}

  <div
    class="community-carousel__track"
    ref="track"
    tabindex="0"
    role="group"
    aria-label="Community gallery"
  >
    {% content_for 'blocks' %}
  </div>

  {%- if carousel_settings.show_dots -%}
    <div
      class="community-carousel__dots"
      ref="dots"
      role="tablist"
      aria-label="Community gallery pagination"
      hidden
    ></div>
  {%- endif -%}
</community-carousel>

{% stylesheet %}
  .community-carousel {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'heading'
      'track'
      'dots'
      'cta';
    row-gap: 24px;
    padding-block: var(--community-carousel-padding-block-start, 48px) var(--community-carousel-padding-block-end, 48px);
    background-color: var(--community-carousel-background, #fcf9f5);
  }

  .community-carousel__heading {
    grid-area: heading;
    margin: 0;
    padding-inline: var(--community-carousel-padding-inline, 20px);
    font-family: var(--font-heading--family);
    font-weight: 800;
    font-size: 40px;
    line-height: 40px;
    text-transform: uppercase;
    color: var(--community-carousel-heading-color, #231f20);
  }

  .community-carousel__cta {
    grid-area: cta;
    justify-self: start;
    margin-inline: var(--community-carousel-padding-inline, 20px);
    padding: 12px 24px;
    border-radius: 2px;
    background-color: var(--community-carousel-button-background, #9bd7d7);
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 14px;
    line-height: 16px;
    text-decoration: none;
    color: var(--community-carousel-button-text-color, #231f20);
  }

  .community-carousel__track {
    grid-area: track;
    display: flex;
    flex-direction: row;
    gap: var(--community-carousel-card-gap, 16px);
    padding-inline: var(--community-carousel-padding-inline, 20px);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .community-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .community-carousel__dots {
    grid-area: dots;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-self: start;
    gap: 6px;
    padding: 12px 16px;
    margin-inline: var(--community-carousel-padding-inline, 20px);
  }

  .community-carousel__dots[hidden] {
    display: none;
  }

  .community-carousel__dot {
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 3px;
    background-color: var(--community-carousel-dot-color, #231f20);
    opacity: 0.35;
    cursor: pointer;
    transition: width 0.2s ease, opacity 0.2s ease;
  }

  .community-carousel__dot[aria-selected='true'] {
    width: 18px;
    opacity: 1;
  }

  @media screen and (min-width: 750px) {
    .community-carousel {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'heading cta'
        'track track'
        'dots dots';
      align-items: center;
      row-gap: 32px;
    }

    .community-carousel__heading {
      font-size: 56px;
      line-height: 56px;
    }

    .community-carousel__cta {
      justify-self: end;
      align-self: center;
    }

    .community-carousel__dots {
      justify-self: end;
      gap: 8px;
      padding: 16px 24px;
    }

    .community-carousel__dot {
      width: 8px;
      height: 8px;
      border-radius: 4px;
    }

    .community-carousel__dot[aria-selected='true'] {
      width: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .community-carousel__dot {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('community-carousel')) {
    class CommunityCarousel extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.community-carousel__track');
        this.dots = this.querySelector('.community-carousel__dots');

        if (!this.track) return;

        this.activeIndex = 0;
        this.pageCount = 0;
        this.scrollFrame = null;

        this.handleScroll = this.handleScroll.bind(this);
        this.handleResize = this.handleResize.bind(this);

        this.track.addEventListener('scroll', this.handleScroll, { passive: true });

        if (typeof ResizeObserver !== 'undefined') {
          this.resizeObserver = new ResizeObserver(this.handleResize);
          this.resizeObserver.observe(this.track);
        } else {
          window.addEventListener('resize', this.handleResize);
        }

        this.build();
      }

      disconnectedCallback() {
        if (this.track) {
          this.track.removeEventListener('scroll', this.handleScroll);
        }

        if (this.resizeObserver) {
          this.resizeObserver.disconnect();
        } else {
          window.removeEventListener('resize', this.handleResize);
        }

        if (this.scrollFrame) {
          cancelAnimationFrame(this.scrollFrame);
        }
      }

      get pageWidth() {
        const width = this.track.clientWidth;
        return width > 0 ? width : 1;
      }

      build() {
        if (!this.dots) return;

        const pageCount = Math.ceil(this.track.scrollWidth / this.pageWidth);

        if (pageCount === this.pageCount) {
          this.syncActive();
          return;
        }

        this.pageCount = pageCount;
        this.dots.textContent = '';

        if (pageCount < 2) {
          this.dots.hidden = true;
          return;
        }

        this.dots.hidden = false;

        for (let index = 0; index < pageCount; index++) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'community-carousel__dot';
          dot.setAttribute('role', 'tab');
          dot.setAttribute('aria-label', 'Go to slide ' + (index + 1));
          dot.setAttribute('aria-selected', index === 0 ? 'true' : 'false');
          dot.addEventListener('click', () => this.goTo(index));
          this.dots.appendChild(dot);
        }

        this.syncActive();
      }

      goTo(index) {
        this.track.scrollTo({ left: index * this.pageWidth, behavior: 'smooth' });
      }

      handleScroll() {
        if (this.scrollFrame) return;

        this.scrollFrame = requestAnimationFrame(() => {
          this.scrollFrame = null;
          this.syncActive();
        });
      }

      handleResize() {
        this.build();
      }

      syncActive() {
        if (!this.dots || this.dots.hidden) return;

        const maxIndex = this.pageCount - 1;
        let index = Math.round(this.track.scrollLeft / this.pageWidth);

        if (index < 0) index = 0;
        if (index > maxIndex) index = maxIndex;

        if (index === this.activeIndex) {
          const current = this.dots.children[index];
          if (current && current.getAttribute('aria-selected') === 'true') return;
        }

        this.activeIndex = index;

        for (let i = 0; i < this.dots.children.length; i++) {
          this.dots.children[i].setAttribute('aria-selected', i === index ? 'true' : 'false');
        }
      }
    }

    customElements.define('community-carousel', CommunityCarousel);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Community carousel",
  "tag": null,
  "blocks": [
    {
      "type": "_community-card"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the community @dropps"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#231F20"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FCF9F5"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#9BD7D7"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#231F20"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Pagination color",
      "default": "#231F20"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-inline",
      "label": "Horizontal",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Community carousel",
      "blocks": {
        "card-1": {
          "type": "_community-card",
          "settings": {
            "card_variant": "media"
          }
        },
        "card-2": {
          "type": "_community-card",
          "settings": {
            "card_variant": "promo",
            "background_color": "#C24829"
          }
        },
        "card-3": {
          "type": "_community-card",
          "settings": {
            "card_variant": "panel"
          }
        }
      },
      "block_order": ["card-1", "card-2", "card-3"]
    }
  ]
}
{% endschema %}
