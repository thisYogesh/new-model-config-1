{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{% unless product_resource == blank %}
  {% render 'variant-main-picker', product_resource: product_resource, section: section, product: product %}

  {%- comment -%}
    Per-option-value CSS variables consumed by the buybox overrides in snippets/variant-picker-styles.liquid:
    --selected-value  → selected value shown next to the option name (keyed on :checked so it stays in sync)
    --swatch-label    → value name rendered inside swatch pills
    --savings-badge   → "N% OFF" badge for option values whose variant has a compare-at price
  {%- endcomment -%}
  {%- unless product_resource.has_only_default_variant -%}
    {%- assign picker_scope = 'variant-picker[data-block-id="' | append: block.id | append: '"]' -%}
    {% style %}
      {%- for product_option in product_resource.options_with_values -%}
        {%- for product_option_value in product_option.values -%}
          {%- liquid
            assign value_id = product_option_value.id
            assign value_label = product_option_value | replace: '"', "'"
            assign value_variant = product_option_value.variant
            assign has_savings = false
            if block.settings.show_savings_badges and value_variant != blank and value_variant.compare_at_price > value_variant.price
              assign savings_amount = value_variant.compare_at_price | minus: value_variant.price
              assign savings_percent = savings_amount | times: 100.0 | divided_by: value_variant.compare_at_price | round
              assign has_savings = true
            endif
          -%}
          {{ picker_scope }} .variant-option--buttons:has(> .variant-option__button-label > input[data-option-value-id="{{ value_id }}"]:checked) {
            --selected-value: "{{ value_label }}";
          }
          {%- if product_option_value.swatch -%}
            {{ picker_scope }} .variant-option__button-label:has(> input[data-option-value-id="{{ value_id }}"]) {
              --swatch-label: "{{ value_label }}";
            }
          {%- endif -%}
          {%- if has_savings -%}
            {{ picker_scope }} .variant-option__button-label:has(> input[data-option-value-id="{{ value_id }}"]) {
              --savings-badge: "{{ savings_percent }}% OFF";
            }
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {% endstyle %}
  {%- endunless -%}
{% endunless %}

{% schema %}
{
  "name": "t:names.product_variant_picker",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.type"
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "dropdowns",
          "label": "t:options.dropdowns"
        },
        {
          "value": "buttons",
          "label": "t:options.buttons"
        }
      ],
      "default": "buttons"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "t:settings.swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_savings_badges",
      "label": "Show savings badges",
      "info": "Shows a \"% OFF\" badge on option values whose variant has a compare-at price.",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "option_label_text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default",
      "alpha": true
    },
    {
      "type": "select",
      "id": "variant_style_class",
      "label": "t:settings.variant_button_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "info": "t:info.edit_variants_in_theme_settings"
    },
    {
      "type": "color",
      "id": "custom_variant_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "select",
      "id": "selected_variant_style_class",
      "label": "t:settings.selected_variant_button_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.variant_style == 'buttons' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_variant_picker",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
