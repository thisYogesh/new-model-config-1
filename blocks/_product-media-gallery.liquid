{%- liquid
  assign gallery_variant = closest.product.selected_or_first_available_variant
  assign show_sale_badge = false
  if block.settings.show_sale_badge and gallery_variant != blank and gallery_variant.compare_at_price > gallery_variant.price
    assign sale_savings_amount = gallery_variant.compare_at_price | minus: gallery_variant.price
    assign sale_savings_percent = sale_savings_amount | times: 100.0 | divided_by: gallery_variant.compare_at_price | round
    assign show_sale_badge = true
  endif
-%}

{% render 'product-media-gallery-content',
  media_presentation: block.settings.media_presentation,
  block_settings: block.settings,
  block_id: block.id,
  block_shopify_attributes: block.shopify_attributes,
  block: block,
  section: section
%}

{%- if block.settings.media_background_color != blank or show_sale_badge -%}
  {% style %}
    {%- if block.settings.media_background_color != blank -%}
      .product-information__media media-gallery {
        --media-background: {{ block.settings.media_background_color }};
      }
    {%- endif -%}
    {%- if show_sale_badge -%}
      .product-information__media media-gallery::before {
        content: "Save {{ sale_savings_percent }}%";
        --sale-badge-color: {{ block.settings.sale_badge_color | default: '#E9EA6B' }};
      }
    {%- endif -%}
  {% endstyle %}
{%- endif -%}

{% stylesheet %}
  /* Product page buybox overrides for the media gallery */
  .product-information__media {
    position: relative;
  }

  .product-information__media media-gallery {
    --slideshow-thumbnails-padding-block: 20px 0px;
    --slideshow-thumbnails-padding-inline: 0px;
  }

  /* "Save X%" badge (content set inline when the selected variant is on sale) */
  .product-information__media media-gallery::before {
    position: absolute;
    top: calc(var(--padding-block-start, 0px) + 16px);
    inset-inline-start: calc(var(--padding-inline-start, 0px) + 16px);
    z-index: var(--layer-raised);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 12px;
    background-color: var(--sale-badge-color, #E9EA6B);
    color: #231F20;
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    pointer-events: none;
  }

  /* Media background */
  .product-information__media .product-media-container {
    background-color: var(--media-background, transparent);
  }

  .product-information__media .product-media-container.media-fit-contain :is(img, .deferred-media__poster-image) {
    background-color: var(--media-background, var(--color-background));
  }

  /* Thumbnail rail */
  .product-information__media .slideshow-controls__thumbnails {
    gap: 12px;
    padding-inline: 0;
    margin-inline: 0;
  }

  .product-information__media .slideshow-controls__thumbnails .slideshow-control {
    border-radius: 2px;
    border: 1.5px solid transparent;
    background-color: var(--media-background, transparent);
  }

  .product-information__media .slideshow-controls__thumbnails .slideshow-control img {
    border-radius: 1px;
  }

  .product-information__media .slideshow-controls__thumbnails .slideshow-control[aria-selected='true'] {
    outline: none;
    border: 1.5px solid #231F20;
  }

  /* Pagination dots */
  .product-information__media slideshow-controls[controls-on-media] {
    --color-foreground: #231F20;
    --color-foreground-rgb: 35 31 32;

    mix-blend-mode: normal;
  }

  .product-information__media .slideshow-controls__dots {
    gap: 8px;
    padding: 16px 24px;
  }

  .product-information__media .slideshow-controls__dots button {
    width: auto;
    height: 16px;
    margin: 0;
    padding: 0;
    border-radius: 4px;
  }

  .product-information__media .slideshow-controls__dots button::after {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(35 31 32 / 0.2);
    box-shadow: none;
  }

  .product-information__media .slideshow-controls__dots button[aria-selected='true']::after {
    width: 24px;
    background-color: #231F20;
    box-shadow: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .product-information__media .slideshow-controls__dots button::after {
      transition: width var(--animation-speed) var(--animation-easing);
    }
  }

  @media screen and (max-width: 749px) {
    .product-information__media .slideshow-controls__dots {
      gap: 6px;
      padding: 12px 16px;
    }

    .product-information__media .slideshow-controls__dots button {
      height: 12px;
      border-radius: 3px;
    }

    .product-information__media .slideshow-controls__dots button::after {
      width: 6px;
      height: 6px;
      border-radius: 3px;
    }

    .product-information__media .slideshow-controls__dots button[aria-selected='true']::after {
      width: 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_media",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "media_presentation",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        }
      ],
      "default": "grid",
      "info": "t:info.carousel_layout_on_mobile"
    },
    {
      "type": "header",
      "content": "t:content.grid",
      "visible_if": "{{ block.settings.media_presentation == 'grid' }}"
    },
    {
      "type": "select",
      "id": "media_columns",
      "label": "t:settings.columns",
      "options": [
        {
          "value": "one",
          "label": "t:options.one_number"
        },
        {
          "value": "two",
          "label": "t:options.two_number"
        }
      ],
      "default": "one",
      "visible_if": "{{ block.settings.media_presentation == 'grid' }}"
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.media_presentation == 'grid' }}"
    },
    {
      "type": "checkbox",
      "id": "large_first_image",
      "label": "t:settings.full_width_first_image",
      "default": false,
      "visible_if": "{{ block.settings.media_presentation == 'grid' and block.settings.media_columns == 'two' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icons",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.large_arrows"
        },
        {
          "value": "chevron_large",
          "label": "t:options.large_chevrons"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ block.settings.media_presentation == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "slideshow_controls_style",
      "label": "t:settings.desktop_pagination",
      "options": [
        {
          "value": "dots",
          "label": "t:options.dots"
        },
        {
          "value": "counter",
          "label": "t:options.counter"
        },
        {
          "value": "thumbnails",
          "label": "t:options.thumbnails"
        }
      ],
      "visible_if": "{{ block.settings.media_presentation == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "slideshow_mobile_controls_style",
      "label": "t:settings.mobile_pagination",
      "options": [
        {
          "value": "dots",
          "label": "t:options.dots"
        },
        {
          "value": "counter",
          "label": "t:options.counter"
        },
        {
          "value": "hint",
          "label": "t:options.hint"
        },
        {
          "value": "thumbnails",
          "label": "t:options.thumbnails"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:content.thumbnails",
      "visible_if": "{{ block.settings.slideshow_controls_style == 'thumbnails' or block.settings.slideshow_mobile_controls_style == 'thumbnails' }}"
    },
    {
      "type": "select",
      "id": "thumbnail_position",
      "label": "t:settings.desktop_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.direction_start"
        },
        {
          "value": "bottom",
          "label": "t:options.bottom"
        },
        {
          "value": "right",
          "label": "t:options.direction_end"
        }
      ],
      "default": "bottom",
      "visible_if": "{{ block.settings.slideshow_controls_style == 'thumbnails' }}"
    },
    {
      "type": "range",
      "id": "thumbnail_width",
      "label": "t:settings.width_desktop",
      "min": 44,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ block.settings.slideshow_controls_style == 'thumbnails' }}"
    },
    {
      "type": "range",
      "id": "thumbnail_radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.slideshow_controls_style == 'thumbnails' or block.settings.slideshow_mobile_controls_style == 'thumbnails' }}"
    },
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "1/1.25",
          "label": "t:options.portrait"
        },
        {
          "value": "1",
          "label": "t:options.square"
        },
        {
          "value": "2/1",
          "label": "t:options.landscape"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "checkbox",
      "id": "constrain_to_viewport",
      "label": "t:settings.limit_media_to_screen_height",
      "default": false
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "t:settings.media_fit",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.aspect_ratio == 'adapt' and block.settings.constrain_to_viewport == true }}"
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "extend_media",
      "label": "t:settings.extend_media_to_screen_edge",
      "default": true,
      "visible_if": "{{ section.settings.content_width == 'content-center-aligned' }}"
    },
    {
      "type": "checkbox",
      "id": "zoom",
      "label": "t:settings.enable_zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "t:settings.enable_video_looping",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_variants",
      "default": false,
      "label": "t:settings.hide_unselected_variant_media"
    },
    {
      "type": "header",
      "content": "Sale badge"
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show sale badge",
      "info": "Shows a \"Save X%\" badge when the selected variant has a compare-at price.",
      "default": false
    },
    {
      "type": "color",
      "id": "sale_badge_color",
      "label": "Sale badge color",
      "default": "#E9EA6B",
      "visible_if": "{{ block.settings.show_sale_badge }}"
    },
    {
      "type": "header",
      "content": "Media background"
    },
    {
      "type": "color",
      "id": "media_background_color",
      "label": "Media background color",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_media"
    }
  ]
}
{% endschema %}
