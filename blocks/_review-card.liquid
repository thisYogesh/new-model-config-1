{% liquid
  assign rating_val = block.settings.rating
  assign full_stars = rating_val | floor
  assign decimal_part = rating_val | minus: full_stars
  assign half_star_index = full_stars | plus: 1
%}

<div
  class="review-card"
  data-category="{{ block.settings.category }}"
  {{ block.shopify_attributes }}
>
  <div class="review-card__body">
    <div class="review-card__media">
      {%- if block.settings.image != blank -%}
        {{
          block.settings.image
          | image_url: width: block.settings.image.width
          | image_tag:
            class: 'review-card__image',
            widths: '200,310,400,620',
            sizes: '(min-width: 750px) 310px, 200px',
            loading: 'lazy',
            alt: block.settings.image.alt
        }}
      {%- else -%}
        <div class="review-card__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'review-card__placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    <div class="review-card__content">
      <div class="review-card__stars" aria-label="Rating: {{ rating_val }} out of 5 stars">
        {%- for i in (1..5) -%}
          {%- if i <= full_stars -%}
            <span class="review-card__star">{{ 'icon-toggle-star-24px-2.svg' | inline_asset_content }}</span>
          {%- elsif i == half_star_index and decimal_part > 0 -%}
            <span class="review-card__star">{{ 'icon-toggle-star-half-24px.svg' | inline_asset_content }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if block.settings.review_title != blank -%}
        <p class="review-card__title">{{ block.settings.review_title }}</p>
      {%- endif -%}

      {%- if block.settings.review_text != blank -%}
        <p class="review-card__quote">{{ block.settings.review_text }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="review-card__footer">
    <div class="review-card__author">
      <span class="review-card__check">{{ 'check-circle-2.svg' | inline_asset_content }}</span>
      <span class="review-card__author-name">{{ block.settings.author }}</span>
    </div>

    {%- if block.settings.product_label != blank -%}
      {%- if block.settings.product_url != blank -%}
        <a href="{{ block.settings.product_url }}" class="review-card__product-link">
          {{- block.settings.product_label -}}
        </a>
      {%- else -%}
        <span class="review-card__product-link">{{ block.settings.product_label }}</span>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .review-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    scroll-snap-align: start;
  }

  .review-card__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .review-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .review-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .review-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: #f0f0f0;
  }

  .review-card__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
  }

  .review-card__content {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .review-card__stars {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1px;
  }

  .review-card__star {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
  }

  .review-card__star svg {
    width: 14px;
    height: 14px;
    display: block;
  }

  .review-card__title {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 16px;
    line-height: 20px;
    color: #231F20;
  }

  .review-card__quote {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 14px;
    line-height: 16px;
    color: #231F20;
  }

  .review-card__footer {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block-start: 6px;
    border-block-start: 1px solid #231F20;
  }

  .review-card__author {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }

  .review-card__check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 21px;
    height: 21px;
  }

  .review-card__check svg {
    width: 21px;
    height: 21px;
    display: block;
  }

  .review-card__author-name {
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-align: center;
    color: #231F20;
  }

  .review-card__product-link {
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 14px;
    line-height: 18px;
    letter-spacing: 0.14px;
    text-decoration: underline;
    color: #231F20;
  }

  @media screen and (min-width: 750px) {
    .review-card {
      gap: 24px;
    }

    .review-card__quote {
      font-size: 16px;
      line-height: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Review card",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Star rating",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 4.5
    },
    {
      "type": "text",
      "id": "review_title",
      "label": "Review title",
      "default": "Eco-friendly product"
    },
    {
      "type": "textarea",
      "id": "review_text",
      "label": "Review text",
      "default": "“The pods are convenient to use as I have low vision and do not want to measure a cleaning product. I like that I could choose an unscented product. Best of all, it comes in recyclable packaging.”"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author name",
      "default": "Kathy F"
    },
    {
      "type": "text",
      "id": "product_label",
      "label": "Product label",
      "default": "Laundry Pods"
    },
    {
      "type": "url",
      "id": "product_url",
      "label": "Product link"
    },
    {
      "type": "text",
      "id": "category",
      "label": "Filter category",
      "default": "Set-In Stains"
    }
  ],
  "presets": [
    {
      "name": "Review card"
    }
  ]
}
{% endschema %}
