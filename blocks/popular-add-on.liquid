{% liquid
  assign addon = block.settings.product
  if addon == blank
    assign addon = closest.product.metafields['shopify--discovery--product_recommendation'].complementary_products.value.first
  endif
  assign addon_variant = addon.selected_or_first_available_variant
  assign addon_form_id = 'PopularAddOn-Form-' | append: block.id
  assign addon_image = addon_variant.featured_media.preview_image | default: addon.featured_image
%}

{% if addon != blank and addon_variant != blank %}
  <div
    class="popular-add-on spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {% if block.settings.heading != blank %}
      <p class="popular-add-on__label">{{ block.settings.heading }}</p>
    {% endif %}

    <div class="popular-add-on__card">
      <div class="popular-add-on__content">
        {% if addon_image != blank %}
          <div class="popular-add-on__image">
            {{
              addon_image
              | image_url: width: 320
              | image_tag: loading: 'lazy', alt: addon.title, widths: '160,240,320', sizes: '81px'
            }}
          </div>
        {% endif %}
        <div class="popular-add-on__info">
          <a
            class="popular-add-on__title"
            href="{{ addon.url }}"
          >
            {{- addon.title -}}
          </a>
          <div class="popular-add-on__meta">
            {% if addon_variant.option1 != blank %}
              <span class="popular-add-on__option">
                <span
                  class="popular-add-on__chip"
                  style="--chip-color: {{ block.settings.chip_color }};"
                ></span>
                {{ addon_variant.option1 }}
              </span>
            {% endif %}
            {% if addon_variant.option2 != blank %}
              <span class="popular-add-on__option popular-add-on__option--muted">{{ addon_variant.option2 }}</span>
            {% endif %}
          </div>
        </div>
      </div>

      <product-form-component
        class="popular-add-on__form"
        data-section-id="{{ section.id }}"
        data-product-id="{{ addon.id }}"
        data-product-url="{{ addon.url }}"
        on:submit="/handleSubmit"
      >
        <div
          class="visually-hidden"
          aria-live="assertive"
          role="status"
          aria-atomic="true"
          ref="liveRegion"
        ></div>
        {%- form 'product', addon, id: addon_form_id, data-type: 'add-to-cart-form' -%}
          <input
            type="hidden"
            name="id"
            ref="variantId"
            value="{{ addon_variant.id }}"
          >
          <button
            type="submit"
            name="add"
            class="popular-add-on__button"
            ref="addToCartButton"
            {% unless addon_variant.available %}
              disabled
            {% endunless %}
          >
            {% if addon_variant.available %}
              Add to Cart
              <span aria-hidden="true">|</span>
              {{ addon_variant.price | money }}
            {% else %}
              Sold out
            {% endif %}
          </button>
        {%- endform -%}
      </product-form-component>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .popular-add-on {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .popular-add-on__label {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 14px;
    line-height: 18px;
    letter-spacing: 0.14px;
    color: #231f20;
  }

  .popular-add-on__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: #fff;
    border: 1px solid #231f20;
    padding: 16px;
  }

  .popular-add-on__content {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-inline: 6px;
    min-width: 0;
  }

  .popular-add-on__image {
    flex-shrink: 0;
    width: 81px;
  }

  .popular-add-on__image img {
    width: 81px;
    height: 86px;
    object-fit: contain;
  }

  .popular-add-on__info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    min-width: 0;
  }

  .popular-add-on__title {
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 16px;
    line-height: 20px;
    color: #231f20;
    text-decoration: none;
    overflow-wrap: break-word;
  }

  .popular-add-on__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .popular-add-on__option {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 14px;
    line-height: 18px;
    letter-spacing: 0.14px;
    color: #231f20;
  }

  .popular-add-on__option--muted {
    color: #8f928f;
  }

  .popular-add-on__chip {
    display: block;
    width: 13px;
    height: 13px;
    border-radius: 2px;
    border: 1px solid #231f20;
    background: var(--chip-color, #99d9d9);
  }

  .popular-add-on__form {
    display: block;
  }

  .popular-add-on__form form {
    margin: 0;
  }

  .popular-add-on__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    background: transparent;
    border: 1px solid #14495b;
    border-radius: 0;
    color: #14495b;
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 14px;
    line-height: 16px;
    padding: 12px 24px;
    cursor: pointer;
  }

  .popular-add-on__button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media screen and (min-width: 750px) {
    .popular-add-on__card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 16px 32px 16px 16px;
    }

    .popular-add-on__content {
      gap: 18px;
    }

    .popular-add-on__image {
      width: 75px;
    }

    .popular-add-on__image img {
      width: 75px;
      height: 80px;
    }

    .popular-add-on__info {
      gap: 10px;
    }

    .popular-add-on__button {
      width: auto;
      min-width: 185px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Popular add-on",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular Add-on"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Add-on product",
      "info": "Leave empty to use the first complementary product from Shopify Search & Discovery."
    },
    {
      "type": "color",
      "id": "chip_color",
      "label": "Option chip color",
      "default": "#99D9D9"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Popular add-on",
      "category": "Product"
    }
  ]
}
{% endschema %}
