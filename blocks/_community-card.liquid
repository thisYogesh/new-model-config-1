{% liquid
  assign card_settings = block.settings
  assign card_variant = card_settings.card_variant

  assign has_promo_link = false
  if card_settings.promo_link_label != blank
    assign has_promo_link = true
  endif

  assign has_panel_link = false
  if card_settings.panel_link_label != blank
    assign has_panel_link = true
  endif
%}

<div
  class="community-card community-card--{{ card_variant }}"
  style="
    --community-card-width: {{ card_settings.card_width }}px;
    --community-card-height: {{ card_settings.card_height }}px;
    --community-card-background: {{ card_settings.background_color }};
    --community-card-promo-heading-color: {{ card_settings.promo_heading_color }};
    --community-card-promo-link-color: {{ card_settings.promo_link_color }};
    --community-card-panel-background: {{ card_settings.panel_background_color }};
    --community-card-panel-text-color: {{ card_settings.panel_text_color }};
  "
  {{ block.shopify_attributes }}
>
  {%- if card_variant == 'promo' -%}
    <div class="community-card__promo">
      {%- if card_settings.badge_image != blank -%}
        <div class="community-card__badge">
          {{
            card_settings.badge_image
            | image_url: width: 400
            | image_tag:
              class: 'community-card__badge-image',
              widths: '200,400',
              sizes: '160px',
              loading: 'lazy',
              alt: card_settings.badge_image.alt
          }}
        </div>
      {%- endif -%}

      {%- if card_settings.promo_heading != blank -%}
        <div class="community-card__promo-heading">{{ card_settings.promo_heading }}</div>
      {%- endif -%}

      {%- if has_promo_link -%}
        <a
          class="community-card__promo-link"
          href="{{ card_settings.promo_link_url | default: '#' }}"
        >
          {{- card_settings.promo_link_label -}}
        </a>
      {%- endif -%}
    </div>

  {%- elsif card_variant == 'stacked' -%}
    <div class="community-card__stack">
      <div class="community-card__stack-item">
        {%- if card_settings.image != blank -%}
          {{
            card_settings.image
            | image_url: width: 800
            | image_tag:
              class: 'community-card__media',
              widths: '323,646,969',
              sizes: '(min-width: 750px) 323px, 277px',
              loading: 'lazy',
              alt: card_settings.image.alt
          }}
        {%- else -%}
          <div class="community-card__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'community-card__placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <div class="community-card__stack-item">
        {%- if card_settings.image_2 != blank -%}
          {{
            card_settings.image_2
            | image_url: width: 800
            | image_tag:
              class: 'community-card__media',
              widths: '323,646,969',
              sizes: '(min-width: 750px) 323px, 277px',
              loading: 'lazy',
              alt: card_settings.image_2.alt
          }}
        {%- else -%}
          <div class="community-card__placeholder">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'community-card__placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    </div>

  {%- else -%}
    <div class="community-card__media-wrapper">
      {%- if card_settings.image != blank -%}
        {{
          card_settings.image
          | image_url: width: 900
          | image_tag:
            class: 'community-card__media',
            widths: '277,554,831',
            sizes: '277px',
            loading: 'lazy',
            alt: card_settings.image.alt
        }}
      {%- else -%}
        <div class="community-card__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'community-card__placeholder-svg' }}
        </div>
      {%- endif -%}

      {%- if card_variant == 'panel' -%}
        <div class="community-card__panel">
          {%- if card_settings.panel_image != blank -%}
            <div class="community-card__panel-image">
              {{
                card_settings.panel_image
                | image_url: width: 300
                | image_tag:
                  class: 'community-card__panel-image-media',
                  widths: '150,300',
                  sizes: '120px',
                  loading: 'lazy',
                  alt: card_settings.panel_image.alt
              }}
            </div>
          {%- endif -%}

          {%- if card_settings.panel_heading != blank -%}
            <div class="community-card__panel-heading">{{ card_settings.panel_heading }}</div>
          {%- endif -%}

          {%- if has_panel_link -%}
            <a
              class="community-card__panel-link"
              href="{{ card_settings.panel_link_url | default: '#' }}"
            >
              {{- card_settings.panel_link_label -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .community-card {
    flex: 0 0 auto;
    width: var(--community-card-width, 277px);
    scroll-snap-align: start;
  }

  .community-card__media-wrapper {
    position: relative;
    display: block;
    width: 100%;
    height: var(--community-card-height, 435px);
    overflow: hidden;
    background-color: var(--community-card-background, #fcf9f5);
  }

  .community-card__media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .community-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: var(--community-card-background, #fcf9f5);
  }

  .community-card__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
  }

  /* Promo card variant */
  .community-card__promo {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    height: var(--community-card-height, 435px);
    padding: 32px 24px;
    background-color: var(--community-card-background, #fcf9f5);
    text-align: center;
  }

  .community-card__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 160px;
  }

  .community-card__badge-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .community-card__promo-heading {
    font-family: var(--font-heading--family);
    font-size: 32px;
    line-height: 32px;
    letter-spacing: -0.96px;
    text-align: center;
    color: var(--community-card-promo-heading-color, #fef27f);
  }

  .community-card__promo-heading > * {
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
  }

  .community-card__promo-link {
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 16px;
    text-decoration: underline;
    color: var(--community-card-promo-link-color, #e9ea6b);
  }

  /* Overlay panel variant */
  .community-card__panel {
    position: absolute;
    inset-inline: 14px;
    inset-block-end: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 16px 14px;
    border: 1px solid #231f20;
    border-radius: 2px;
    background-color: var(--community-card-panel-background, #482b73);
    text-align: center;
  }

  .community-card__panel-image {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 120px;
  }

  .community-card__panel-image-media {
    display: block;
    width: 100%;
    height: auto;
  }

  .community-card__panel-heading {
    font-family: var(--font-heading--family);
    font-size: 20px;
    line-height: 22px;
    letter-spacing: -0.6px;
    color: var(--community-card-panel-text-color, #f4c9e3);
  }

  .community-card__panel-heading > * {
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
  }

  .community-card__panel-link {
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 16px;
    text-decoration: underline;
    color: var(--community-card-panel-text-color, #f4c9e3);
  }

  /* Stacked dual-media variant */
  .community-card__stack {
    display: flex;
    flex-direction: column;
    gap: 19px;
    width: 100%;
    height: var(--community-card-height, 435px);
  }

  .community-card__stack-item {
    position: relative;
    flex: 1 1 0;
    min-height: 0;
    overflow: hidden;
    background-color: var(--community-card-background, #fcf9f5);
  }

  @media screen and (min-width: 750px) {
    .community-card--stacked {
      width: 323px;
    }

    .community-card__promo-heading {
      font-size: 32px;
      line-height: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Community card",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "card_variant",
      "label": "Card type",
      "options": [
        {
          "value": "media",
          "label": "Image"
        },
        {
          "value": "promo",
          "label": "Promo"
        },
        {
          "value": "panel",
          "label": "Image with panel"
        },
        {
          "value": "stacked",
          "label": "Two stacked images"
        }
      ],
      "default": "media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FCF9F5"
    },
    {
      "type": "header",
      "content": "Promo"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Badge image"
    },
    {
      "type": "richtext",
      "id": "promo_heading",
      "label": "Promo heading",
      "default": "<p>Save 20% on your first order</p>"
    },
    {
      "type": "color",
      "id": "promo_heading_color",
      "label": "Promo heading color",
      "default": "#FEF27F"
    },
    {
      "type": "text",
      "id": "promo_link_label",
      "label": "Promo link label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "promo_link_url",
      "label": "Promo link"
    },
    {
      "type": "color",
      "id": "promo_link_color",
      "label": "Promo link color",
      "default": "#E9EA6B"
    },
    {
      "type": "header",
      "content": "Panel"
    },
    {
      "type": "image_picker",
      "id": "panel_image",
      "label": "Panel image"
    },
    {
      "type": "richtext",
      "id": "panel_heading",
      "label": "Panel heading",
      "default": "<p>Refill. Reuse. Repeat.</p>"
    },
    {
      "type": "text",
      "id": "panel_link_label",
      "label": "Panel link label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "panel_link_url",
      "label": "Panel link"
    },
    {
      "type": "color",
      "id": "panel_background_color",
      "label": "Panel background",
      "default": "#482B73"
    },
    {
      "type": "color",
      "id": "panel_text_color",
      "label": "Panel text color",
      "default": "#F4C9E3"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "min": 240,
      "max": 340,
      "step": 1,
      "unit": "px",
      "default": 277
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card height",
      "min": 300,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 435
    }
  ],
  "presets": [
    {
      "name": "Community card"
    }
  ]
}
{% endschema %}
