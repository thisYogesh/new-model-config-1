    {
      "type": "image_picker",
      "id": "badge_2_image",
      "label": "Badge 2 image",
      "info": "Leave empty to use the bundled icon."
    },
    {
      "type": "text",
      "id": "badge_2_caption",
      "label": "Badge 2 caption",
      "default": "Leaping Bunny"
    },
    {
      "type": "image_picker",
      "id": "badge_3_image",
      "label": "Badge 3 image",
      "info": "Leave empty to use the bundled icon."
    },
    {
      "type": "text",
      "id": "badge_3_caption",
      "label": "Badge 3 caption",
      "default": "EPA Safer Choice"
    }
  ],
  "presets": [
    {
      "name": "Clean ingredients bar"
    }
  ]
}
{% endschema %}
