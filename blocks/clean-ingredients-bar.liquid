{%- liquid
  assign badge_1_image = block.settings.badge_1_image
  assign badge_2_image = block.settings.badge_2_image
  assign badge_3_image = block.settings.badge_3_image
-%}

<div class="clean-ingredients-bar" {{ block.shopify_attributes }}>
  <div class="clean-ingredients-bar__inner">
    {%- if block.settings.heading != blank -%}
      <div class="clean-ingredients-bar__heading">{{ block.settings.heading }}</div>
    {%- endif -%}

    <div class="clean-ingredients-bar__rows">
      {%- if block.settings.row_1_label != blank or block.settings.row_1_description != blank -%}
        <div class="clean-ingredients-bar__row">
          <span class="clean-ingredients-bar__label">{{ block.settings.row_1_label }}</span>
          <span class="clean-ingredients-bar__description">{{ block.settings.row_1_description }}</span>
        </div>
      {%- endif -%}

      {%- if block.settings.row_2_label != blank or block.settings.row_2_description != blank -%}
        <div class="clean-ingredients-bar__row">
          <span class="clean-ingredients-bar__label">{{ block.settings.row_2_label }}</span>
          <span class="clean-ingredients-bar__description">{{ block.settings.row_2_description }}</span>
        </div>
      {%- endif -%}

      {%- if block.settings.row_3_label != blank or block.settings.row_3_description != blank -%}
        <div class="clean-ingredients-bar__row">
          <span class="clean-ingredients-bar__label">{{ block.settings.row_3_label }}</span>
          <span class="clean-ingredients-bar__description">{{ block.settings.row_3_description }}</span>
        </div>
      {%- endif -%}

      {%- if block.settings.row_4_label != blank or block.settings.row_4_description != blank -%}
        <div class="clean-ingredients-bar__row">
          <span class="clean-ingredients-bar__label">{{ block.settings.row_4_label }}</span>
          <span class="clean-ingredients-bar__description">{{ block.settings.row_4_description }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- if block.settings.cta_label != blank -%}
      {%- if block.settings.cta_link != blank -%}
        <a class="clean-ingredients-bar__cta" href="{{ block.settings.cta_link }}">
          {{- block.settings.cta_label -}}
        </a>
      {%- else -%}
        <span class="clean-ingredients-bar__cta">{{ block.settings.cta_label }}</span>
      {%- endif -%}
    {%- endif -%}

    <div class="clean-ingredients-bar__badges">
      <div class="clean-ingredients-bar__badge">
        <div class="clean-ingredients-bar__badge-media clean-ingredients-bar__badge-media--square">
          {%- if badge_1_image != blank -%}
            {{
              badge_1_image
              | image_url: width: 216
              | image_tag:
                class: 'clean-ingredients-bar__badge-image',
                widths: '72,144,216',
                sizes: '72px',
                loading: 'lazy',
                alt: block.settings.badge_1_caption
            }}
          {%- else -%}
            <img
              class="clean-ingredients-bar__badge-image"
              src="{{ 'wrapper.svg' | asset_url }}"
              alt="{{ block.settings.badge_1_caption }}"
              width="72"
              height="72"
              loading="lazy"
            >
          {%- endif -%}
        </div>
        {%- if block.settings.badge_1_caption != blank -%}
          <span class="clean-ingredients-bar__badge-caption">{{ block.settings.badge_1_caption }}</span>
        {%- endif -%}
      </div>

      <span class="clean-ingredients-bar__badge-divider" aria-hidden="true"></span>

      <div class="clean-ingredients-bar__badge">
        <div class="clean-ingredients-bar__badge-media clean-ingredients-bar__badge-media--square">
          {%- if badge_2_image != blank -%}
            {{
              badge_2_image
              | image_url: width: 216
              | image_tag:
                class: 'clean-ingredients-bar__badge-image',
                widths: '72,144,216',
                sizes: '72px',
                loading: 'lazy',
                alt: block.settings.badge_2_caption
            }}
          {%- else -%}
            <img
              class="clean-ingredients-bar__badge-image"
              src="{{ 'wrapper-2.svg' | asset_url }}"
              alt="{{ block.settings.badge_2_caption }}"
              width="72"
              height="72"
              loading="lazy"
            >
          {%- endif -%}
        </div>
        {%- if block.settings.badge_2_caption != blank -%}
          <span class="clean-ingredients-bar__badge-caption">{{ block.settings.badge_2_caption }}</span>
        {%- endif -%}
      </div>

      <span class="clean-ingredients-bar__badge-divider" aria-hidden="true"></span>

      <div class="clean-ingredients-bar__badge">
        <div class="clean-ingredients-bar__badge-media clean-ingredients-bar__badge-media--narrow">
          {%- if badge_3_image != blank -%}
            {{
              badge_3_image
              | image_url: width: 123
              | image_tag:
                class: 'clean-ingredients-bar__badge-image',
                widths: '41,82,123',
                sizes: '41px',
                loading: 'lazy',
                alt: block.settings.badge_3_caption
            }}
          {%- else -%}
            <img
              class="clean-ingredients-bar__badge-image"
              src="{{ 'wrapper-4.svg' | asset_url }}"
              alt="{{ block.settings.badge_3_caption }}"
              width="41"
              height="72"
              loading="lazy"
            >
          {%- endif -%}
        </div>
        {%- if block.settings.badge_3_caption != blank -%}
          <span class="clean-ingredients-bar__badge-caption">{{ block.settings.badge_3_caption }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .clean-ingredients-bar {
    --clean-ingredients-bar-panel-background: #e9ea6b;
    --clean-ingredients-bar-ink: #231f20;

    display: flex;
    justify-content: center;
    width: 100%;
    padding-block: 36px;
    padding-inline: 20px;
  }

  .clean-ingredients-bar__inner {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    max-width: 335px;
    padding: 20px;
    color: var(--clean-ingredients-bar-ink);
    background-color: var(--clean-ingredients-bar-panel-background);
  }

  .clean-ingredients-bar__heading {
    width: 100%;
    font-family: var(--font-heading--family);
    font-size: 40px;
    font-weight: 400;
    line-height: 40px;
    letter-spacing: -1.2px;
    text-align: start;
    text-wrap: balance;
  }

  .clean-ingredients-bar__rows {
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: flex-end;
    width: 100%;
    padding-block-start: 24px;
  }

  .clean-ingredients-bar__row {
    display: flex;
    flex-direction: row;
    gap: 16px;
    align-items: flex-start;
    padding-block-end: 2px;
  }

  .clean-ingredients-bar__label {
    flex: 0 0 90px;
    min-width: 0;
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 600;
    line-height: 20px;
    overflow-wrap: break-word;
  }

  .clean-ingredients-bar__description {
    flex: 0 1 189px;
    min-width: 0;
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 500;
    line-height: 20px;
    overflow-wrap: break-word;
  }

  .clean-ingredients-bar__cta {
    align-self: flex-start;
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 600;
    line-height: 16px;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .clean-ingredients-bar__badges {
    display: flex;
    flex-direction: row;
    gap: 32px;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .clean-ingredients-bar__badge {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    min-width: 0;
  }

  .clean-ingredients-bar__badge-media {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 72px;
  }

  .clean-ingredients-bar__badge-media--square {
    width: 72px;
  }

  .clean-ingredients-bar__badge-media--narrow {
    width: 41px;
  }

  .clean-ingredients-bar__badge-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .clean-ingredients-bar__badge-caption {
    display: none;
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 500;
    line-height: 14px;
    letter-spacing: 0.12px;
    text-align: center;
  }

  .clean-ingredients-bar__badge-divider {
    flex: 0 0 auto;
    width: 1px;
    height: 72px;
    background-color: var(--clean-ingredients-bar-ink);
  }

  @media screen and (min-width: 750px) {
    .clean-ingredients-bar {
      padding-block: 0;
      padding-inline: 0;
    }

    .clean-ingredients-bar__inner {
      display: grid;
      grid-template-columns: auto minmax(0, 574px);
      grid-template-rows: auto auto;
      gap: 24px 32px;
      align-items: start;
      justify-content: center;
      max-width: 950px;
      min-height: 556px;
      padding: 48px 32px;
    }

    .clean-ingredients-bar__heading {
      grid-column: 1;
      grid-row: 1;
      width: 279px;
      font-size: 56px;
      line-height: 56px;
      letter-spacing: -1.68px;
    }

    .clean-ingredients-bar__rows {
      grid-column: 2;
      grid-row: 1 / span 2;
      gap: 16px;
      align-self: center;
      padding-block-start: 0;
    }

    .clean-ingredients-bar__row {
      gap: 24px;
    }

    .clean-ingredients-bar__label {
      flex: 0 0 198px;
    }

    .clean-ingredients-bar__description {
      flex: 0 1 320px;
    }

    .clean-ingredients-bar__cta {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
    }

    .clean-ingredients-bar__badges {
      grid-column: 1 / -1;
      grid-row: 3;
      gap: 30px;
      align-items: center;
      justify-content: flex-start;
      max-width: 510px;
    }

    .clean-ingredients-bar__badge {
      gap: 8px;
    }

    .clean-ingredients-bar__badge-caption {
      display: block;
    }

    .clean-ingredients-bar__badge-divider {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Clean ingredients bar",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Formula"
    },
    {
      "type": "header",
      "content": "Ingredient rows"
